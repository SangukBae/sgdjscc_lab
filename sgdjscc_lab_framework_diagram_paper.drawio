        <mxCell id="p3_key_recon" value="Keyframe Reconstruction&#10;complete Fig. 2 pipeline&#10;optional bidirectional prepass" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEFD8;strokeColor=#3D7A48;strokeWidth=3;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1710" y="340" width="400" height="200" as="geometry"/></mxCell>
