        <mxCell id="p3_boundary" value="Research boundary: fixed/SKIM and PSSS/SKEM selectors are executable. The PSSS real backend uses next-token probabilities, but the resulting SKEM/PSSS workflow remains an approximation because the LGVSC paper does not disclose all implementation details. Mock/proxy PSSS and interpolation backends cannot support final quality claims." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#8A6D00;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="4720" y="1510" width="2220" height="230" as="geometry"/></mxCell>
        <mxCell id="p3_outputs_list" value="Per-run provenance carried into reports&#10;&#10;selector_backend / psss_backend / model ID&#10;conditioning_mode / generation backend / mock flag&#10;Rx-legal start/end anchor usage&#10;n_keyframes / segment-length distribution&#10;n_reuse / n_recompute_semantic / n_recompute_motion / n_generate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#674A8B;strokeWidth=2;fontSize=13;align=left;spacing=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="4720" y="1820" width="2220" height="360" as="geometry"/></mxCell>
        <mxCell id="p3_e_output_provenance" value="metadata" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#674A8B;strokeWidth=2;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_output" target="p3_outputs_list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3_legend" value="All target-frame inputs to real generation are receiver-legal: reconstructed keyframe anchors plus transmitted/logical caption, packet, and side information. The SegmentGenerationRequest intentionally has no ground-truth target-frame field." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="2460" width="6880" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

