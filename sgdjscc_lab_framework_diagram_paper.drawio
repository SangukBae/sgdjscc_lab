        <mxCell id="p2_sampler" value="MDTv2 Semantic Diffusion Sampler&#10;standard DPM-Solver++ 2M path&#10;or fast-fading water-filling loop&#10;optional DDIM/Karras step policy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4E5;strokeColor=#3D7A48;strokeWidth=3;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="4610" y="680" width="530" height="240" as="geometry"/></mxCell>
