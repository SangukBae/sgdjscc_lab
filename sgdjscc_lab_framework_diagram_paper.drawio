        <mxCell id="p2_vae_enc" value="Frozen VAE Encoder&#10;x*2-1 -> latent_dist.mean&#10;/ scaling factor 15.45" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B5D80;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1140" y="300" width="360" height="170" as="geometry"/></mxCell>
