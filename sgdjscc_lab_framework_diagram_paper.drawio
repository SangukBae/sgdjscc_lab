        <mxCell id="p2_cond_policy" value="ChannelConditionPolicy&#10;latent | joint | blind conditioned&#10;resolve guidance, steps, CSI mode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D7A48;strokeWidth=2;dashed=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="4550" y="300" width="400" height="170" as="geometry"/></mxCell>
